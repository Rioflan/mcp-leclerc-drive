# Copier en .env (chmod 600) et remplir. Ne jamais committer .env.

# --- Secrets obligatoires -------------------------------------------------

# Jeton partagé web ↔ navigateur (réseau interne). Générer avec :
#   openssl rand -hex 32
BRIDGE_TOKEN=

# Hash du mot de passe de l'interface (pas le mot de passe lui-même). Générer avec
# (voir README) : docker build -t leclerc-drive-web:local web
#   printf '%s' 'mon mot de passe' | docker run --rm -i leclerc-drive-web:local src/hash-password.mjs
UI_PASSWORD_HASH=

# Sujet ntfy : sur ntfy.sh, toute personne qui le connaît peut lire les
# notifications. Le choisir long et aléatoire :
#   echo "drive-$(openssl rand -hex 12)"
NTFY_TOPIC=

# --- Notifications ---------------------------------------------------------

# Serveur ntfy (https://ntfy.sh par défaut, ou http://ntfy:8080 avec le profil
# selfhosted-ntfy).
NTFY_URL=https://ntfy.sh
# Jeton d'accès ntfy (serveur auto-hébergé ou compte ntfy.sh), facultatif.
NTFY_TOKEN=
# Priorité des alertes de disponibilité (1 à 5).
NTFY_PRIORITY=4
# Notifier aussi quand un article du panier passe en rupture.
NOTIFY_CART_OUT_OF_STOCK=false

# --- Fréquence des vérifications --------------------------------------------

# Intervalle entre deux vérifications (minimum 10m) + délai aléatoire ajouté
# entre 0 et CHECK_JITTER. Formats : 90s, 30m, 1h, 1h30m.
CHECK_INTERVAL=30m
CHECK_JITTER=10m
# Échecs d'affilée (session expirée, blocage) avant une notification d'alerte.
FAILURE_THRESHOLD=3

# --- Interface ---------------------------------------------------------------

# Ports publiés sur 127.0.0.1 uniquement.
WEB_PORT=8080
VNC_PORT=6080
# Durée d'une session de connexion.
SESSION_TTL=7d
# URL publique de l'interface (lien dans les notifications), ex. https://drive.exemple.fr
PUBLIC_URL=
# Derrière un reverse proxy HTTPS : cookie Secure et IP client lue dans X-Forwarded-For.
UI_SECURE_COOKIE=false
TRUST_PROXY=false

# --- Magasin (facultatif) ----------------------------------------------------

# Par défaut, le magasin est détecté depuis l'onglet Leclerc Drive du VNC.
# Pour le fixer : l'URL du drive ressemble à
#   https://fd4-courses.leclercdrive.fr/magasin-123456-654321-Ville/
#   LECLERC_HOST=fd4-courses.leclercdrive.fr  LECLERC_STORE_ID=123456  LECLERC_STORE_NOPR=654321
LECLERC_STORE_ID=
LECLERC_STORE_NOPR=
LECLERC_HOST=

# --- ntfy auto-hébergé (profil selfhosted-ntfy) -------------------------------

# URL à laquelle le téléphone joint ce serveur ntfy.
NTFY_PUBLIC_URL=http://localhost:8090
NTFY_BIND=127.0.0.1
NTFY_PORT=8090
NTFY_BEHIND_PROXY=false
